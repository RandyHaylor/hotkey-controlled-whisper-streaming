.DS_Store
# Locally-bundled faster-whisper model weights (downloaded by bootstrap_models.py).
# Smaller models (tiny / tiny.en, base / base.en) are committed; base is
# tracked via Git LFS due to its 139 MB size; tiny/tiny.en (73 MB) fit
# under the 100 MB plain-git limit. Other sizes are ignored to keep LFS
# bandwidth reasonable.
/models/*
!/models/tiny/
!/models/tiny.en/
!/models/base/
!/models/base.en/
!/models/moonshine-tiny-streaming/
!/models/moonshine-small-streaming/
!/models/sherpa-zipformer-en-20m/
!/models/sherpa-zipformer-en-2023-06-26/
!/models/sherpa-zipformer-en-2023-06-21/
!/models/sherpa-online-punct-en/
# Transcript output dir (per-user, auto-created).
/vtt_recordings/
# sherpa-onnx scratch sandbox: a full upstream clone + large model tarballs.
# The POC scripts are preserved (tracked) under sherpa_poc/ instead.
/sherpa-test/
